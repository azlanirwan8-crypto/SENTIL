# Salin menjadi .env (sudah di-ignore git) lalu isi dengan nilai milikmu.
# Nilai di bawah hanya contoh — jangan commit berkas .env.

# Wajib agar workspace dan hasil penarikan tersimpan di database.
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# Opsional: kanal sosial. Tanpa ini kanalnya melaporkan needs_setup, bukan nol ulasan.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
APIFY_API_TOKEN=
NEWS_RSS_URLS=

# Opsional: penamaan kategori label (lib/label-naming.mjs). Tanpa kunci, kolom Category memakai
# nama dari kata reviewers / istilah halaman toko saja — penarikan data tetap berjalan normal.
# Model default gemini-2.0-flash; ganti lewat GEMINI_MODEL bila perlu.
GEMINI_API_KEY=
GEMINI_MODEL=

# Izin tertulis untuk kanal berbayar (Apify). Actor menagih per hasil, jadi token saja tidak
# pernah memicu run: tanpa baris ini kanal facebook/instagram/tiktok/x melaporkan
# consent_required dan tidak ada permintaan yang dikirim.
APIFY_ALLOWED=false

# Gerbang kuota per pengunjung (lib/rate-limit.mjs). Alat ini tanpa akun, jadi satu-satunya
# penahan loop refresh adalah kuota. Nilai di bawah adalah bawaannya; kosongkan untuk bawaan.
# Hitungan disimpan di Supabase bila migrasi db/supabase.sql sudah dijalankan; kalau belum,
# hitungan hidup di memori satu instance fungsi.
QUOTA_ENABLED=true
QUOTA_SYNC_BURST=6
QUOTA_SYNC_DAY=40
QUOTA_DISCOVER_BURST=20
QUOTA_DISCOVER_DAY=400
# Garam untuk hash alamat IP di tabel kuota. Tanpa ini kunci pengunjung tetap ter-hash, tetapi
# salt membuat jejaknya tidak bisa dibalik dengan menebak ruang alamat.
QUOTA_KEY_SALT=

# Penarikan terjadwal (cron Vercel -> /api/refresh). Vercel mengirim kunci ini sebagai
# Authorization: Bearer. Tanpa CRON_SECRET fungsi menjawab 501 dan tidak ada sumber yang
# disentuh — ia sengaja gagal tertutup, bukan terbuka untuk siapa pun yang tahu alamatnya.
CRON_SECRET=
REFRESH_STALE_HOURS=6
REFRESH_BUDGET_MS=270000
REFRESH_MIN_ROOM_MS=150000

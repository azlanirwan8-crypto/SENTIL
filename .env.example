# Salin berkas ini menjadi .env (atau .env.local) lalu isi dengan kredensial milik Anda sendiri.
# Kedua berkas itu sudah di-git-ignore dan tidak pernah disajikan lewat HTTP.
# Jangan menempelkan kunci ke kolom browser, chat, atau commit.
#
# Bila kunci Anda tersimpan di Vercel, tarik sendiri ke folder ini tanpa lewat chat:
#   vercel env pull .env.local
# .env.local mengambil alih nilai dari .env, dan keduanya kalah oleh variabel
# yang benar-benar dipasang pada environment proses.

# YouTube Data API v3 (aktifkan API-nya dulu di project Google Cloud Anda).
GOOGLE_API_KEY=
YOUTUBE_API_KEY=

# Opsional: batasi ke ID video tertentu (11 karakter, dipisah koma).
# Kosong = mencari video dengan frasa "wondr merchant" melalui API resmi.
YOUTUBE_VIDEO_IDS=

# Apify: satu token untuk kanal X, Instagram, TikTok, Facebook, dan Google Reviews.
# Pemakaian actor dapat memakan kuota berbayar akun Anda.
APIFY_API_TOKEN=

# Opsional: ganti actor atau input per kanal bila akun Anda memakai actor lain.
# APIFY_ACTOR_X=apidojo/tweet-scraper
# APIFY_INPUT_X={"query":"\"wondr merchant\"","maxItems":100,"queryType":1}
# APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# APIFY_INPUT_INSTAGRAM={"search":["wondr merchant"],"searchType":"hashtags","maximumItemsPerQuery":100}
# APIFY_ACTOR_TIKTOK=apify/tiktok-scraper
# APIFY_ACTOR_FACEBOOK=apify/facebook-pages-scraper
# APIFY_ACTOR_GOOGLEMAPS=compass/crawler-google-places

# Hanya untuk host Node berkelanjutan (Render, Railway, Fly.io, VPS).
# Kosongkan semuanya agar aplikasi tetap hanya bisa diakses dari mesin ini.
# PORT=4173
# BIND_HOST=0.0.0.0
# ALLOWED_HOSTS=nama-anda.onrender.com
# PUBLIC_SCHEME=https
# Wajib diisi begitu BIND_HOST publik atau ALLOWED_HOSTS dipakai. Tanpa kredensial,
# aplikasi menolak start karena tombol Tarik Analisis memicu actor Apify berbayar.
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
# Arahkan ke disk permanen bila host memakai filesystem sementara.
# DATA_PATH=/var/data/online-data.json

# Salin berkas ini menjadi .env (atau .env.local) lalu isi dengan kredensial milik Anda sendiri.
# Kedua berkas itu sudah di-git-ignore dan tidak pernah disajikan lewat HTTP.
# Jangan menempelkan kunci ke kolom browser, chat, atau commit.
#
# Bila kunci Anda tersimpan di Vercel, tarik sendiri ke folder ini tanpa lewat chat:
#   vercel env pull .env.local
# .env.local mengambil alih nilai dari .env, dan keduanya kalah oleh variabel
# yang benar-benar dipasang pada environment proses.

# YouTube Data API v3 (aktifkan API-nya dulu di project Google Cloud Anda).
GOOGLE_API_KEY=
YOUTUBE_API_KEY=

# Opsional: batasi ke ID video tertentu (11 karakter, dipisah koma).
# Kosong = mencari video dengan frasa "wondr merchant" melalui API resmi.
YOUTUBE_VIDEO_IDS=

# Google Places API (New) untuk kanal Google Reviews. Kunci ini dipakai pada header
# X-Goog-Api-Key, bukan di URL. Catatan: Google tidak lagi menyertakan teks ulasan
# pada respons Places untuk pemanggil baru, sehingga kanal ini dapat melaporkan
# "place ditemukan, teks ulasan tidak disediakan API" — itu hasil nyata, bukan nol keluhan.
GOOGLE_PLACES_API_KEY=
# Opsional: ubah frasa pencarian place (dipisah koma).
# GOOGLE_PLACES_QUERIES=wondr merchant,wondr merchant by BNI

# Apify: satu token untuk kanal X, Instagram, TikTok, dan Facebook.
# Pemakaian actor dapat memakan kuota berbayar akun Anda.
APIFY_API_TOKEN=
# Anggaran tunggu actor per penarikan (milidetik). Server lokal memakai 180000 bila
# tidak diisi; function Vercel memakai 120000 agar selesai di bawah maxDuration.
# APIFY_WAIT_MS=150000

# Opsional: ganti actor atau input per kanal bila akun Anda memakai actor lain.
# Nama actor dan field input di bawah diverifikasi terhadap schema actor publik Apify pada
# 24 Oktober 2026. Field yang tidak dikenal actor kini DITOLAK sebelum actor dijalankan
# (tidak ada biaya), bukan lagi berujung "tidak ada hasil" palsu.
# PERHATIAN: resultsLimit/resultsPerPage adalah batas jumlah hasil di sisi actor. Jika jumlah
# item yang dikembalikan mencapai angka itu, hasil terpotong dan dasbor menandainya
# "terpotong di batas ini". Naikkan angkanya untuk membaca lebih banyak; tiap item menambah biaya.
# APIFY_ACTOR_X=apidojo/tweet-scraper
# APIFY_INPUT_X={"searchTerms":["\"wondr merchant\"","\"wondr merchant by BNI\"","wondrmerchant"],"sort":"Latest + Top"}
# APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# APIFY_INPUT_INSTAGRAM={"resultsType":"posts","searchType":"hashtag","search":"wondrmerchant, wondrmerchantbni","searchLimit":250,"resultsLimit":250}
# APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
# APIFY_INPUT_TIKTOK={"searchQueries":["\"wondr merchant\"","\"wondr merchant by BNI\""],"resultsPerPage":1000,"videoSearchSorting":"LATEST"}
# APIFY_ACTOR_FACEBOOK=apify/facebook-search-scraper
# APIFY_INPUT_FACEBOOK={"categories":["wondr merchant","wondr merchant by BNI"],"searchType":"posts","resultsLimit":250}

# Jalankan sebagai situs:
# - Vercel: berkas vercel.json + api/*.js sudah disiapkan; function membaca environment
#   deployment. Pasang nama dan kata sandi di bawah agar orang lain tidak memicu
#   penarikan berbayar; tanpa keduanya, Tarik Analisis diblokir oleh middleware.js.
# - Host Node berkelanjutan (Render, Railway, Fly.io, VPS): gunakan server.mjs.
#   Kosongkan semuanya agar aplikasi tetap hanya bisa diakses dari mesin ini.
# PORT=4173
# BIND_HOST=0.0.0.0
# ALLOWED_HOSTS=nama-anda.onrender.com
# PUBLIC_SCHEME=https
# Wajib diisi begitu BIND_HOST publik atau ALLOWED_HOSTS dipakai. Tanpa kredensial,
# server lokal menolak start karena tombol Tarik Analisis memicu actor Apify berbayar.
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
# Arahkan ke disk permanen bila host memakai filesystem sementara.
# DATA_PATH=/var/data/online-data.json
